                    Active Admins: ${offlineAdmins.length} / 2 Max
                  </span>
                </div>
                ${adminRows}
                ${addSecondaryBtn}
              </div>

              <!-- Quick Stats Grid -->
              <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px;">
                <div style="background: #ffffff; padding: 20px; border-radius: 16px; border: 1px solid #e2e8f0;">
                  <div style="font-size: 11px; font-weight: bold; color: #64748b; text-transform: uppercase;">Admissions Queue</div>
                  <div style="font-size: 28px; font-weight: 900; color: #065f46;">${ADMISSION_APPLICATIONS.length} Apps</div>
                  <div style="font-size: 11px; color: #059669; font-weight: bold;">Online & Offline submissions</div>
                </div>
                <div style="background: #ffffff; padding: 20px; border-radius: 16px; border: 1px solid #e2e8f0;">
                  <div style="font-size: 11px; font-weight: bold; color: #64748b; text-transform: uppercase;">Bank Collections</div>
                  <div style="font-size: 24px; font-weight: 900; color: #0f172a;">UGX 2,450,000</div>
                  <div style="font-size: 11px; color: #64748b;">Centenary & SchoolPay</div>
                </div>
                <div style="background: #ffffff; padding: 20px; border-radius: 16px; border: 1px solid #e2e8f0;">
                  <div style="font-size: 11px; font-weight: bold; color: #64748b; text-transform: uppercase;">UNEB Center Code</div>
                  <div style="font-size: 28px; font-weight: 900; color: #b45309;">U0842</div>
                  <div style="font-size: 11px; color: #64748b;">Nyamitanga, Mbarara City</div>
