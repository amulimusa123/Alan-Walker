      // PAGE: ALUMNI
      if (page === 'alumni') {
        root.innerHTML = `
          <div class="max-w-7xl py-8">
            <h1 style="font-size: 32px; font-weight: 900; margin-bottom: 8px;">Old Boys & Old Girls Network (SHIBA)</h1>
            <p style="font-size: 14px; color: #475569; margin-bottom: 24px;">Reunions, Mentorship & School Development · Executive Contacts: <strong>${SCHOOL_DATA.alumniPhone}</strong></p>
