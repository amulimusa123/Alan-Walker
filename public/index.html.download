              </div>
            </div>
          </div>
        `;
        return;
      }

      // PAGE: CONTACT US
      if (page === 'contact') {
        root.innerHTML = `
          <div class="max-w-7xl py-8">
            <h1 style="font-size: 32px; font-weight: 900; margin-bottom: 8px;">Contact & Visit Our Campus</h1>
            <p style="font-size: 14px; color: #475569; margin-bottom: 24px;">${SCHOOL_DATA.location}</p>
            <div class="grid sm:grid-cols-3 gap-6 mb-8">
              <div style="background: #ffffff; padding: 20px; border-radius: 16px; border: 1px solid #e2e8f0;">
                <h3 style="font-size: 16px; font-weight: 800; color: #065f46; margin-bottom: 6px;">📞 Phone Contacts</h3>
                <p style="font-size: 13px; color: #0f172a;"><strong>Admin:</strong> ${SCHOOL_DATA.phone}<br><strong>Alumni:</strong> ${SCHOOL_DATA.alumniPhone}</p>
              </div>
              <div style="background: #ffffff; padding: 20px; border-radius: 16px; border: 1px solid #e2e8f0;">
                <h3 style="font-size: 16px; font-weight: 800; color: #065f46; margin-bottom: 6px;">✉️ Email Address</h3>
                <p style="font-size: 13px; color: #0f172a;">${SCHOOL_DATA.email}<br>P.O. Box 718, Mbarara, Uganda</p>
              </div>
              <div style="background: #ffffff; padding: 20px; border-radius: 16px; border: 1px solid #e2e8f0;">
                <h3 style="font-size: 16px; font-weight: 800; color: #065f46; margin-bottom: 6px;">🗺️ Route from Town</h3>
                <p style="font-size: 12px; color: #475569;">Cross River Rwizi bridge, take Isingiro Road, branch 2 km off highway onto Nyamitanga Hill (5 mins).</p>
