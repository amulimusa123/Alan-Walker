<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shuhadae Islamic Secondary School - Offline Edition</title>
  <meta name="description" content="Offline standalone website and student information portal for Shuhadae Islamic Secondary School, Nyamitanga Division, Mbarara City, Uganda.">
  
  <!-- Standalone Embedded Core CSS (Works 100% with ZERO internet connection) -->
  <style>
    :root {
      --emerald-950: #022c22;
      --emerald-900: #064e3b;
      --emerald-800: #065f46;
      --emerald-700: #047857;
      --emerald-600: #059669;
      --emerald-100: #d1fae5;
      --emerald-50: #ecfdf5;
      --amber-400: #fbbf24;
      --amber-500: #f59e0b;
      --amber-600: #d97706;
      --slate-900: #0f172a;
      --slate-800: #1e293b;
      --slate-700: #334155;
      --slate-600: #475569;
      --slate-200: #e2e8f0;
      --slate-100: #f1f5f9;
      --slate-50: #f8fafc;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
    body { background-color: var(--slate-50); color: var(--slate-900); line-height: 1.5; padding-bottom: 70px; }
    a { color: inherit; text-decoration: none; }
    button { cursor: pointer; border: none; background: none; font-family: inherit; }
    .max-w-7xl { max-width: 1240px; margin: 0 auto; padding: 0 16px; }
    .bg-emerald-900 { background-color: var(--emerald-900); }
    .bg-emerald-950 { background-color: var(--emerald-950); }
    .bg-emerald-800 { background-color: var(--emerald-800); }
    .bg-emerald-700 { background-color: var(--emerald-700); }
    .bg-emerald-50 { background-color: var(--emerald-50); }
    .bg-amber-400 { background-color: var(--amber-400); }
    .bg-amber-500 { background-color: var(--amber-500); }
    .bg-slate-900 { background-color: var(--slate-900); }
    .bg-slate-100 { background-color: var(--slate-100); }
    .bg-white { background-color: #ffffff; }
    .text-white { color: #ffffff; }
    .text-emerald-100 { color: var(--emerald-100); }
    .text-emerald-700 { color: var(--emerald-700); }
    .text-emerald-800 { color: var(--emerald-800); }
    .text-amber-300 { color: #fde047; }
    .text-amber-400 { color: var(--amber-400); }
    .text-slate-500 { color: var(--slate-500); }
    .text-slate-600 { color: var(--slate-600); }
    .text-slate-700 { color: var(--slate-700); }
    .text-slate-900 { color: var(--slate-900); }
    .rounded-xl { border-radius: 12px; }
    .rounded-2xl { border-radius: 16px; }
    .rounded-3xl { border-radius: 24px; }
    .rounded-full { border-radius: 9999px; }
    .shadow-sm { box-shadow: 0 1px 2px rgba(0,0,0,0.05); }
    .shadow-md { box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); }
    .shadow-xl { box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1); }
    .border { border: 1px solid var(--slate-200); }
    .border-emerald-700 { border-color: var(--emerald-700); }
    .border-amber-400 { border-color: var(--amber-400); }
    .grid { display: grid; }
    .flex { display: flex; }
    .items-center { align-items: center; }
    .justify-between { justify-content: space-between; }
    .justify-center { justify-content: center; }
    .gap-2 { gap: 8px; }
    .gap-3 { gap: 12px; }
    .gap-4 { gap: 16px; }
    .gap-6 { gap: 24px; }
    .gap-8 { gap: 32px; }
    .p-3 { padding: 12px; }
    .p-4 { padding: 16px; }
    .p-6 { padding: 24px; }
    .p-8 { padding: 32px; }
    .py-2 { padding-top: 8px; padding-bottom: 8px; }
    .py-3 { padding-top: 12px; padding-bottom: 12px; }
    .py-8 { padding-top: 32px; padding-bottom: 32px; }
    .py-12 { padding-top: 48px; padding-bottom: 48px; }
    .px-4 { padding-left: 16px; padding-right: 16px; }
    .px-6 { padding-left: 24px; padding-right: 24px; }
    .mb-2 { margin-bottom: 8px; }
    .mb-4 { margin-bottom: 16px; }
    .mb-6 { margin-bottom: 24px; }
    .mb-8 { margin-bottom: 32px; }
    .font-bold { font-weight: 700; }
    .font-extrabold { font-weight: 800; }
    .font-black { font-weight: 900; }
    .text-xs { font-size: 12px; }
    .text-sm { font-size: 14px; }
    .text-base { font-size: 16px; }
    .text-lg { font-size: 18px; }
    .text-xl { font-size: 20px; }
    .text-2xl { font-size: 24px; }
    .text-3xl { font-size: 30px; }
    .text-4xl { font-size: 36px; }
    .table-auto { width: 100%; border-collapse: collapse; }
    .table-auto th, .table-auto td { padding: 10px 14px; border-bottom: 1px solid var(--slate-200); text-align: left; }
    .sticky-top { position: sticky; top: 0; z-index: 40; }
    .fixed-bottom { position: fixed; bottom: 0; left: 0; right: 0; z-index: 50; }
    
    @media (min-width: 640px) {
      .sm\:grid-cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .sm\:grid-cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .sm\:flex-row { flex-direction: row; }
    }
    @media (min-width: 1024px) {
      .lg\:grid-cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .lg\:grid-cols-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
      .lg\:grid-cols-5 { grid-template-columns: repeat(5, minmax(0, 1fr)); }
    }
  </style>
</head>
<body>

  <!-- Offline Standalone Banner Indicator -->
  <div style="background-color: #065f46; color: #fef08a; padding: 6px 16px; font-size: 11px; font-weight: bold; display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #f59e0b;">
    <div style="display: flex; align-items: center; gap: 8px;">
      <span style="display: inline-block; width: 8px; height: 8px; background: #22c55e; border-radius: 50%;"></span>
      <span>SHUHADAE ISLAMIC SS · 100% STANDALONE OFFLINE EDITION</span>
      <span style="opacity: 0.8; font-weight: normal; margin-left: 6px;">(Stored locally in your browser - no internet needed)</span>
    </div>
    <div style="display: flex; gap: 10px;">
      <button onclick="downloadSelf()" style="background: #f59e0b; color: #022c22; padding: 4px 10px; border-radius: 6px; font-size: 11px; font-weight: 800; cursor: pointer;">
        📥 Download index.html
      </button>
      <span style="color: #a7f3d0;">UNEB Center: U0842</span>
    </div>
  </div>

  <!-- Primary Top Navigation Bar -->
  <header class="bg-white border sticky-top shadow-sm">
    <div class="max-w-7xl flex items-center justify-between" style="height: 70px;">
      <div onclick="navigateTo('home')" style="display: flex; align-items: center; gap: 12px; cursor: pointer;">
        <div style="width: 44px; height: 44px; border-radius: 12px; background: linear-gradient(135deg, #065f46, #022c22); border: 2px solid #f59e0b; display: flex; align-items: center; justify-content: center; color: #fde047; font-weight: 900; font-size: 20px;">
          S
        </div>
        <div>
          <div style="font-weight: 900; font-size: 17px; line-height: 1.1; color: var(--slate-900);">Shuhadae Islamic Secondary School</div>
          <div style="font-size: 11px; color: var(--emerald-700); font-weight: 700;">Nyamitanga Division, Mbarara City · O & A-Level</div>
        </div>
      </div>

      <div style="display: flex; align-items: center; gap: 10px;">
        <button onclick="navigateTo('login')" style="background: #f1f5f9; color: #0f172a; padding: 6px 14px; border-radius: 10px; font-size: 12px; font-weight: 800; border: 1px solid #cbd5e1;">
          🔐 Portal Login
        </button>
        <button onclick="navigateTo('portal')" style="background: #065f46; color: #ffffff; padding: 6px 14px; border-radius: 10px; font-size: 12px; font-weight: 800;">
          📊 Student Dashboard
        </button>
      </div>
    </div>
  </header>

  <!-- DYNAMIC VIEW CONTAINER -->
  <main id="app-root"></main>

  <!-- FLOATING PERSISTENT WEBPAGES NAVIGATOR (Zero-dependency Hash Navigation) -->
  <div class="fixed-bottom" style="background: rgba(15, 23, 42, 0.95); backdrop-filter: blur(8px); border-top: 1px solid #334155; padding: 8px 12px; display: flex; align-items: center; justify-content: space-between; gap: 8px; overflow-x: auto;">
    <div style="font-size: 11px; font-weight: 900; color: #fde047; white-space: nowrap; padding-right: 6px;">
      ⚡ Pages:
    </div>
    <div style="display: flex; gap: 6px; overflow-x: auto;">
      <button onclick="navigateTo('login')" class="nav-btn" data-page="login" style="padding: 5px 10px; border-radius: 8px; font-size: 11px; font-weight: 700; white-space: nowrap; color: #e2e8f0; background: #1e293b;">
        🔐 Login (First Page)
      </button>
      <button onclick="navigateTo('home')" class="nav-btn" data-page="home" style="padding: 5px 10px; border-radius: 8px; font-size: 11px; font-weight: 700; white-space: nowrap; color: #e2e8f0; background: #1e293b;">
        🏠 1. Home
      </button>
      <button onclick="navigateTo('about')" class="nav-btn" data-page="about" style="padding: 5px 10px; border-radius: 8px; font-size: 11px; font-weight: 700; white-space: nowrap; color: #e2e8f0; background: #1e293b;">
        📖 2. About Us
      </button>
      <button onclick="navigateTo('academics')" class="nav-btn" data-page="academics" style="padding: 5px 10px; border-radius: 8px; font-size: 11px; font-weight: 700; white-space: nowrap; color: #e2e8f0; background: #1e293b;">
        🎓 3. Academics
      </button>
      <button onclick="navigateTo('admissions')" class="nav-btn" data-page="admissions" style="padding: 5px 10px; border-radius: 8px; font-size: 11px; font-weight: 700; white-space: nowrap; color: #e2e8f0; background: #1e293b;">
        📋 4. Admissions & Fees
      </button>
      <button onclick="navigateTo('campus-life')" class="nav-btn" data-page="campus-life" style="padding: 5px 10px; border-radius: 8px; font-size: 11px; font-weight: 700; white-space: nowrap; color: #e2e8f0; background: #1e293b;">
        📸 5. Campus Life
      </button>
      <button onclick="navigateTo('alumni')" class="nav-btn" data-page="alumni" style="padding: 5px 10px; border-radius: 8px; font-size: 11px; font-weight: 700; white-space: nowrap; color: #e2e8f0; background: #1e293b;">
        👥 6. Alumni
      </button>
      <button onclick="navigateTo('contact')" class="nav-btn" data-page="contact" style="padding: 5px 10px; border-radius: 8px; font-size: 11px; font-weight: 700; white-space: nowrap; color: #e2e8f0; background: #1e293b;">
        📍 7. Contact Us
      </button>
      <button onclick="navigateTo('portal')" class="nav-btn" data-page="portal" style="padding: 5px 10px; border-radius: 8px; font-size: 11px; font-weight: 700; white-space: nowrap; color: #e2e8f0; background: #1e293b;">
        📊 Student Portal
      </button>
      <button onclick="toggleOfflineChat()" style="padding: 5px 10px; border-radius: 8px; font-size: 11px; font-weight: 700; white-space: nowrap; color: #022c22; background: #fde047; cursor: pointer;">
        💬 AI Counselor (Offline)
      </button>
      <button onclick="downloadSelf()" style="padding: 5px 10px; border-radius: 8px; font-size: 11px; font-weight: 800; white-space: nowrap; color: #022c22; background: #f59e0b; cursor: pointer;">
        📥 Download index.html
      </button>
    </div>
  </div>

  <!-- FLOATING OFFLINE AI COUNSELOR CHAT MODAL -->
  <div id="offline-chat-modal" style="display: none; position: fixed; bottom: 65px; right: 16px; width: 360px; max-width: calc(100vw - 32px); height: 460px; background: #ffffff; border-radius: 20px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.3); border: 2px solid #065f46; z-index: 60; overflow: hidden; display: none; flex-direction: column;">
    <div style="background: linear-gradient(135deg, #065f46, #022c22); padding: 14px 16px; color: #ffffff; display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #f59e0b;">
      <div style="display: flex; align-items: center; gap: 8px;">
        <span style="font-size: 18px;">👳</span>
        <div>
          <div style="font-size: 13px; font-weight: 900;">Ustadh Sulaiman</div>
          <div style="font-size: 10px; color: #a7f3d0;">Offline AI Admissions Counselor</div>
        </div>
      </div>
      <button onclick="toggleOfflineChat()" style="color: #ffffff; font-size: 16px; font-weight: 900; background: none; border: none; cursor: pointer;">✕</button>
    </div>
    
    <div id="chat-log" style="flex: 1; padding: 12px; overflow-y: auto; display: flex; flex-direction: column; gap: 6px; background: #f8fafc; font-size: 12px;">
      <div style="background: #ecfdf5; border: 1px solid #a7f3d0; color: #064e3b; padding: 10px 12px; border-radius: 12px; line-height: 1.4;">
        <strong>Assalamu Alaikum!</strong> Welcome to Shuhadae Islamic Secondary School, Nyamitanga, Mbarara City.<br>
        I am your 100% offline Admissions Assistant. Tap any quick question below or ask me about fees, subjects, or boarding!
      </div>
    </div>

    <!-- Quick question chips -->
    <div style="padding: 8px 12px; background: #ffffff; border-top: 1px solid #e2e8f0; display: flex; gap: 6px; overflow-x: auto;">
      <button onclick="askOfflineChat('What are the S.1 and S.5 fees?')" style="background: #f1f5f9; border: 1px solid #cbd5e1; border-radius: 9999px; padding: 4px 10px; font-size: 10px; font-weight: bold; white-space: nowrap; cursor: pointer;">💰 Fees Structure</button>
      <button onclick="askOfflineChat('Where is the school located and how do I get there?')" style="background: #f1f5f9; border: 1px solid #cbd5e1; border-radius: 9999px; padding: 4px 10px; font-size: 10px; font-weight: bold; white-space: nowrap; cursor: pointer;">📍 Campus Route</button>
      <button onclick="askOfflineChat('Which A-Level combinations are available?')" style="background: #f1f5f9; border: 1px solid #cbd5e1; border-radius: 9999px; padding: 4px 10px; font-size: 10px; font-weight: bold; white-space: nowrap; cursor: pointer;">🔬 Combinations</button>
      <button onclick="askOfflineChat('Tell me about the Islamic prayers and Tahfiz')" style="background: #f1f5f9; border: 1px solid #cbd5e1; border-radius: 9999px; padding: 4px 10px; font-size: 10px; font-weight: bold; white-space: nowrap; cursor: pointer;">🕌 Prayers & Deen</button>
    </div>

    <div style="padding: 10px 12px; background: #ffffff; border-top: 1px solid #e2e8f0; display: flex; gap: 6px;">
      <input id="chat-input" type="text" placeholder="Type question (e.g. fees, boarding)..." style="flex: 1; padding: 8px 12px; border-radius: 8px; border: 1px solid #cbd5e1; font-size: 12px;" onkeydown="if(event.key==='Enter'&&this.value){askOfflineChat(this.value);this.value='';}">
      <button onclick="const el=document.getElementById('chat-input');if(el.value){askOfflineChat(el.value);el.value='';}" style="background: #065f46; color: #ffffff; padding: 8px 14px; border-radius: 8px; font-size: 12px; font-weight: bold; cursor: pointer;">Send</button>
    </div>
  </div>

  <!-- STANDALONE JAVASCRIPT CONTROLLER -->
  <script>
    // Offline Data State
    const SCHOOL_DATA = {
      name: "Shuhadae Islamic Secondary School",
      location: "Nyamitanga Division, Mbarara City, Western Uganda (2 km off Mbarara–Isingiro Highway)",
      phone: "0705 705 967",
      alumniPhone: "0702 365 176 / 0755 260 894",
      email: "info@shuhadaeislamicssmbarara.com",
      unebCenter: "U0842",
      headteacher: "Hajji Dr. Sulaiman Bukenya",
    };

    const STUDENT_DATA = {
      name: "Farooq Kateregga",
      index: "U0842/045",
      admissionNo: "SISS/2022/1089",
      class: "Senior Four Green",
      section: "Boarding Section",
      aggregates: 12,
      division: "Division 1 (Distinction)",
      prayerAttendance: "98%",
      tahfiz: "Surah Al-Kahf completed, Juzu 15 Tajweed",
      feesTotal: 950000,
      feesPaid: 800000,
      feesBalance: 150000,
    };

    // Routing & Rendering Controller
    function navigateTo(page) {
      window.location.hash = page;
      renderPage(page);
      updateNavButtons(page);
      if (page === 'portal') {
        setTimeout(startOfflineCountdownTicker, 50);
      }
      window.scrollTo(0, 0);
    }

    function updateNavButtons(page) {
      document.querySelectorAll('.nav-btn').forEach(btn => {
        if (btn.dataset.page === page) {
          btn.style.background = '#047857';
          btn.style.color = '#ffffff';
          btn.style.boxShadow = '0 0 0 2px #f59e0b';
        } else {
          btn.style.background = '#1e293b';
          btn.style.color = '#e2e8f0';
          btn.style.boxShadow = 'none';
        }
      });
    }

    function renderPage(page) {
      const root = document.getElementById('app-root');
      
      // PAGE: LOGIN (FIRST PAGE)
      if (page === 'login') {
        root.innerHTML = `
          <div style="min-height: 80vh; display: flex; align-items: center; justify-content: center; padding: 24px 16px;">
            <div style="max-width: 440px; width: 100%; background: #ffffff; border-radius: 24px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1); border: 1px solid #cbd5e1; overflow: hidden;">
              <div style="background: linear-gradient(135deg, #064e3b, #022c22); padding: 24px; text-align: center; color: #ffffff; border-bottom: 4px solid #f59e0b;">
                <div style="width: 56px; height: 56px; border-radius: 16px; background: rgba(0,0,0,0.4); border: 2px solid #f59e0b; display: inline-flex; align-items: center; justify-content: center; font-size: 26px; font-weight: 900; color: #fde047; margin-bottom: 8px;">S</div>
                <h2 style="font-size: 18px; font-weight: 900;">Shuhadae Islamic Secondary School</h2>
                <p style="font-size: 11px; color: #a7f3d0;">Academic & Student Portal Gateway (ASIP) · Mbarara</p>
                <div style="margin-top: 6px; font-size: 10px; font-family: monospace; background: rgba(0,0,0,0.3); display: inline-block; padding: 2px 8px; border-radius: 6px; color: #fde047;">UNEB Center: U0842 · Nyamitanga</div>
              </div>

              <div style="padding: 24px;">
                <div style="font-size: 12px; font-weight: bold; color: #334155; margin-bottom: 12px; text-align: center;">Choose Portal Role & Enter Credentials:</div>
                <div style="display: flex; gap: 4px; background: #f1f5f9; padding: 4px; border-radius: 12px; margin-bottom: 16px;">
                  <button type="button" class="role-select-btn" onclick="selectOfflineRole('student', this)" style="flex: 1; padding: 6px; font-size: 11px; font-weight: 800; background: #ffffff; border-radius: 8px; color: #064e3b; box-shadow: 0 1px 2px rgba(0,0,0,0.05); border: none; cursor: pointer;">Student</button>
                  <button type="button" class="role-select-btn" onclick="selectOfflineRole('parent', this)" style="flex: 1; padding: 6px; font-size: 11px; font-weight: 700; color: #64748b; background: transparent; border: none; cursor: pointer;">Parent</button>
                  <button type="button" class="role-select-btn" onclick="selectOfflineRole('staff', this)" style="flex: 1; padding: 6px; font-size: 11px; font-weight: 700; color: #64748b; background: transparent; border: none; cursor: pointer;">Staff</button>
                  <button type="button" class="role-select-btn" onclick="selectOfflineRole('alumni', this)" style="flex: 1; padding: 6px; font-size: 11px; font-weight: 700; color: #64748b; background: transparent; border: none; cursor: pointer;">Alumni</button>
                  <button type="button" class="role-select-btn" onclick="selectOfflineRole('admin', this)" style="flex: 1; padding: 6px; font-size: 11px; font-weight: 700; color: #92400e; background: transparent; border: none; cursor: pointer;">🛡️ Admin</button>
                </div>

                <!-- DYNAMIC ROLE FORM CONTAINER -->
                <div id="offline-form-fields-container">
                  <div style="margin-bottom: 12px;">
                    <label id="offline-id-label" style="font-size: 11px; font-weight: bold; color: #475569; display: block; margin-bottom: 4px;">UNEB Index or Admission Number:</label>
                    <input id="offline-login-id" type="text" placeholder="e.g. U0842/045" style="width: 100%; padding: 10px 12px; border-radius: 10px; border: 1px solid #cbd5e1; font-size: 13px; font-family: monospace;">
                  </div>

                  <div style="margin-bottom: 16px;">
                    <label style="font-size: 11px; font-weight: bold; color: #475569; display: block; margin-bottom: 4px;">Security PIN / Password:</label>
                    <input id="offline-login-pin" type="password" placeholder="Enter PIN / Password" style="width: 100%; padding: 10px 12px; border-radius: 10px; border: 1px solid #cbd5e1; font-size: 13px;">
                  </div>
                </div>

                <div id="login-error-msg" style="display: none; background: #fef2f2; border: 1px solid #fecaca; color: #b91c1c; padding: 8px 12px; border-radius: 8px; font-size: 11px; margin-bottom: 12px;"></div>
                <div id="login-success-msg" style="display: none; background: #ecfdf5; border: 1px solid #a7f3d0; color: #065f46; padding: 8px 12px; border-radius: 8px; font-size: 11px; margin-bottom: 12px;"></div>

                <button id="offline-login-submit-btn" onclick="handleOfflineLogin()" style="width: 100%; padding: 12px; border-radius: 12px; background: #065f46; color: #ffffff; font-weight: 800; font-size: 13px; margin-bottom: 12px; cursor: pointer; border: none;">
                  🔐 Log In to Portal
                </button>

                <div id="offline-admin-create-toggle" style="display: none; text-align: center; margin-bottom: 12px;">
                  <button type="button" onclick="toggleOfflineAdminCreateMode()" style="background: #fef3c7; border: 1px solid #fde047; color: #78350f; font-size: 11px; font-weight: bold; padding: 6px 12px; border-radius: 8px; cursor: pointer;">
                    + Register Secondary Admin (Slot 2/2)
                  </button>
                </div>

                <div style="border-top: 1px solid #e2e8f0; padding-top: 12px; margin-top: 8px; text-align: center;">
                  <div style="font-size: 11px; color: #64748b; display: flex; align-items: center; justify-content: center; gap: 4px;">
                    <span>🛡️</span>
                    <span>Secured Academic Portal • UNEB Center U0842</span>
                  </div>
                </div>

                <div style="text-align: center; margin-top: 12px;">
                  <button onclick="navigateTo('home')" style="font-size: 12px; font-weight: 800; color: #065f46; text-decoration: underline; background: none; border: none; cursor: pointer;">
                    → Skip to Public School Website & Admissions 2025/2026
                  </button>
                </div>
              </div>
            </div>
          </div>
        `;
        return;
      }

      // PAGE: PORTAL DASHBOARD (Admin or Student)
      if (page === 'portal') {
        const offlineAdmins = getOfflineAdmins();
        const isAdmin = currentOfflineUser && currentOfflineUser.role === 'admin' && !currentOfflineUser.preview;

        if (isAdmin) {
          let adminRows = offlineAdmins.map((adm, idx) => `
            <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 16px; margin-bottom: 12px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
              <div>
                <div style="display: flex; align-items: center; gap: 6px;">
                  <span style="font-weight: 900; font-size: 14px; color: #0f172a;">${adm.fullName}</span>
                  <span style="background: ${adm.isPrimary ? '#fef3c7' : '#d1fae5'}; color: ${adm.isPrimary ? '#92400e' : '#065f46'}; font-size: 10px; font-weight: 800; padding: 2px 8px; border-radius: 9999px;">${adm.isPrimary ? 'Primary Admin' : 'Secondary Admin'}</span>
                </div>
                <div style="font-size: 12px; color: #065f46; font-weight: 600; margin-top: 2px;">${adm.title}</div>
                <div style="font-size: 11px; color: #64748b; font-family: monospace; margin-top: 4px;">Username: @${adm.username} • Admin Slot #${idx + 1} of 2</div>
              </div>
              <button onclick="deleteOfflineAdmin('${adm.id}')" style="background: #fef2f2; border: 1px solid #fecaca; color: #b91c1c; font-size: 11px; font-weight: bold; padding: 6px 12px; border-radius: 8px; cursor: pointer;">
                🗑️ Remove Admin
              </button>
            </div>
          `).join('');

          let addSecondaryBtn = '';
          if (offlineAdmins.length === 1) {
            addSecondaryBtn = `
              <div style="background: #f0fdf4; border: 2px dashed #86efac; border-radius: 16px; padding: 20px; text-align: center; margin-top: 12px;">
                <p style="font-size: 13px; font-weight: 800; color: #064e3b; margin-bottom: 4px;">Secondary Admin Slot Available (1/2 Active)</p>
                <p style="font-size: 11px; color: #166534; margin-bottom: 12px;">Under school policy, up to two administrators are permitted. You can register your 2nd admin account now.</p>
                <button onclick="navigateTo('login'); selectOfflineRole('admin'); toggleOfflineAdminCreateMode();" style="background: #065f46; color: #ffffff; font-size: 12px; font-weight: 800; padding: 8px 16px; border-radius: 10px; border: none; cursor: pointer;">
                  + Register Secondary Admin Now (2/2)
                </button>
              </div>
            `;
          } else if (offlineAdmins.length >= 2) {
