                <tr><td><strong>History & Political Ed</strong></td><td>80%</td><td><span style="background: #dbeafe; color: #1e40af; padding: 2px 6px; border-radius: 4px; font-weight: bold;">D2</span></td><td>Thorough grasp of East African constitutional history</td></tr>
