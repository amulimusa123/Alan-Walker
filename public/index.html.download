      }

      // PAGE: ABOUT US
      if (page === 'about') {
        root.innerHTML = `
          <div class="max-w-7xl py-8">
            <h1 style="font-size: 32px; font-weight: 900; margin-bottom: 12px;">About Shuhadae Islamic Secondary School</h1>
            <p style="font-size: 15px; color: #475569; line-height: 1.6; margin-bottom: 32px;">
