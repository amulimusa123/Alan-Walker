                <tr><td><strong>Biology</strong></td><td>88%</td><td><span style="background: #d1fae5; color: #065f46; padding: 2px 6px; border-radius: 4px; font-weight: bold;">D1</span></td><td>Mastery of human physiology and genetics</td></tr>
                <tr><td><strong>Islamic Religious Ed (IRE)</strong></td><td>96%</td><td><span style="background: #d1fae5; color: #065f46; padding: 2px 6px; border-radius: 4px; font-weight: bold;">D1</span></td><td>Top student in class; profound Fiqh insights</td></tr>
