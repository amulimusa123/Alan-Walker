            <div class="grid sm:grid-cols-2 gap-6 mb-8">
              <div style="background: #ffffff; padding: 24px; border-radius: 20px; border: 1px solid #e2e8f0;">
                <h3 style="font-size: 18px; font-weight: 800; color: #065f46; margin-bottom: 8px;">Our Vision</h3>
                <p style="font-size: 13px; color: #475569; line-height: 1.6;">
