    }

    // Save offline form submission
    function saveOfflineForm() {
      const name = document.getElementById('in-name')?.value;
      const cl = document.getElementById('in-class')?.value;
      const sc = document.getElementById('in-score')?.value;
      const ph = document.getElementById('in-phone')?.value;

      if (!name || !ph) {
        alert('Please fill in student name and phone number.');
        return;
      }

      const ref = 'SISS-' + new Date().getFullYear() + '-' + Math.floor(1000 + Math.random() * 9000);
      document.getElementById('adm-form-wrap').innerHTML = `
        <div style="background: #ecfdf5; border: 2px solid #059669; border-radius: 12px; padding: 16px; text-align: center;">
          <div style="font-size: 20px; margin-bottom: 6px;">✓</div>
          <strong style="color: #064e3b; font-size: 15px; display: block;">Application Recorded in Offline Memory!</strong>
          <p style="font-size: 12px; color: #047857; margin: 8px 0;">Reference: <strong>${ref}</strong></p>
          <p style="font-size: 11px; color: #475569;">Student: <strong>${name}</strong> (${cl}) · Score: <strong>${sc}</strong></p>
          <button onclick="window.print()" style="margin-top: 12px; padding: 8px 16px; border-radius: 8px; background: #065f46; color: #ffffff; font-weight: bold; font-size: 12px;">
            🖨️ Print Admission Slip
          </button>
        </div>
      `;
    }

    // Web Speech API Voice Reader
    function speakSpeech() {
      if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel();
        const msg = new SpeechSynthesisUtterance("Assalamu Alaikum. Welcome to Shuhadae Islamic Secondary School, located in Nyamitanga Division, Mbarara City. Knowledge, Faith, and Integrity.");
        msg.rate = 0.95;
        window.speechSynthesis.speak(msg);
      } else {
        alert("Speech synthesis is not supported on this browser.");
      }
    }

    // Offline Admin Accounts System (Enforces max 2 admins limit)
    function getOfflineAdmins() {
      try {
        const raw = localStorage.getItem('shuhadae_admins_offline_v1');
        if (raw) return JSON.parse(raw).slice(0, 2);
      } catch (e) {}
      return [];
    }

    function saveOfflineAdmins(list) {
      try {
        localStorage.setItem('shuhadae_admins_offline_v1', JSON.stringify(list.slice(0, 2)));
      } catch (e) {}
    }

    let offlineAdminCreateMode = false;
    function toggleOfflineAdminCreateMode() {
      offlineAdminCreateMode = !offlineAdminCreateMode;
      renderOfflineRoleForm();
    }

    // Role switcher and authentication handler for portal login
    let selectedOfflineRole = 'student';
    let currentOfflineUser = null;

    function selectOfflineRole(role, btn) {
      selectedOfflineRole = role;
      document.querySelectorAll('.role-select-btn').forEach(b => {
        b.style.background = 'transparent';
        b.style.color = '#64748b';
        b.style.fontWeight = '700';
        b.style.boxShadow = 'none';
      });
      if (btn) {
        btn.style.background = '#ffffff';
        btn.style.color = role === 'admin' ? '#b45309' : '#064e3b';
        btn.style.fontWeight = '800';
        btn.style.boxShadow = '0 1px 2px rgba(0,0,0,0.05)';
      }
      const errEl = document.getElementById('login-error-msg');
      if (errEl) errEl.style.display = 'none';
      const succEl = document.getElementById('login-success-msg');
      if (succEl) succEl.style.display = 'none';

      const admins = getOfflineAdmins();
      if (role === 'admin' && admins.length === 0) {
        offlineAdminCreateMode = true;
      } else {
        offlineAdminCreateMode = false;
      }

      renderOfflineRoleForm();
    }

    function renderOfflineRoleForm() {
      const container = document.getElementById('offline-form-fields-container');
      const submitBtn = document.getElementById('offline-login-submit-btn');
      const toggleBox = document.getElementById('offline-admin-create-toggle');
      if (!container) return;

      const admins = getOfflineAdmins();

      if (selectedOfflineRole === 'admin') {
        if (offlineAdminCreateMode || admins.length === 0) {
          // Admin Creation Form
          const slotNum = admins.length + 1;
          container.innerHTML = `
            <div style="background: #fffbeb; border: 1px solid #fde68a; padding: 10px; border-radius: 10px; margin-bottom: 12px; font-size: 11px; color: #92400e;">
              <strong>🛡️ Create Administrator Account (Slot ${slotNum} of 2)</strong><br>
              Strict rule: Only one or two administrators are permitted in the school portal.
            </div>
            <div style="margin-bottom: 10px;">
              <label style="font-size: 11px; font-weight: bold; color: #475569; display: block; margin-bottom: 3px;">Full Name & Title *</label>
              <input id="admin-create-fullname" type="text" placeholder="e.g. Hajji Sulaiman Kibirige (Headteacher)" style="width: 100%; padding: 8px 10px; border-radius: 8px; border: 1px solid #cbd5e1; font-size: 12px;">
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 10px;">
              <div>
                <label style="font-size: 11px; font-weight: bold; color: #475569; display: block; margin-bottom: 3px;">Username / ID *</label>
                <input id="admin-create-username" type="text" placeholder="e.g. admin" style="width: 100%; padding: 8px 10px; border-radius: 8px; border: 1px solid #cbd5e1; font-size: 12px; font-family: monospace;">
              </div>
              <div>
                <label style="font-size: 11px; font-weight: bold; color: #475569; display: block; margin-bottom: 3px;">Role Title *</label>
                <select id="admin-create-title" style="width: 100%; padding: 8px 6px; border-radius: 8px; border: 1px solid #cbd5e1; font-size: 11px;">
                  <option value="Headteacher / Principal">Headteacher</option>
                  <option value="Deputy Headteacher">Deputy Headteacher</option>
                  <option value="School Bursar">School Bursar</option>
                  <option value="Director of Studies">Director of Studies</option>
                  <option value="IT Administrator">IT Administrator</option>
                </select>
              </div>
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 12px;">
              <div>
                <label style="font-size: 11px; font-weight: bold; color: #475569; display: block; margin-bottom: 3px;">PIN / Password *</label>
                <input id="admin-create-pin" type="password" placeholder="Min. 4 digits" style="width: 100%; padding: 8px 10px; border-radius: 8px; border: 1px solid #cbd5e1; font-size: 12px;">
              </div>
              <div>
                <label style="font-size: 11px; font-weight: bold; color: #475569; display: block; margin-bottom: 3px;">Confirm PIN *</label>
                <input id="admin-create-pin-confirm" type="password" placeholder="Re-enter PIN" style="width: 100%; padding: 8px 10px; border-radius: 8px; border: 1px solid #cbd5e1; font-size: 12px;">
              </div>
            </div>
          `;
          if (submitBtn) {
            submitBtn.textContent = `🛡️ Create Administrator Account (${slotNum}/2)`;
            submitBtn.style.background = '#b45309';
          }
          if (toggleBox) {
            toggleBox.style.display = admins.length > 0 ? 'block' : 'none';
            toggleBox.innerHTML = `
              <button type="button" onclick="toggleOfflineAdminCreateMode()" style="background: none; border: none; color: #065f46; font-size: 11px; font-weight: bold; text-decoration: underline; cursor: pointer;">
                ← Return to Admin Login
              </button>
            `;
          }
        } else {
          // Admin Login Form
          container.innerHTML = `
            <div style="background: #f8fafc; border: 1px solid #e2e8f0; padding: 8px 10px; border-radius: 8px; margin-bottom: 12px; font-size: 11px; color: #334155; display: flex; justify-content: space-between;">
              <span>Registered Administrators: <strong>${admins.length} / 2</strong></span>
              <span style="color: ${admins.length >= 2 ? '#b45309' : '#059669'}; font-weight: bold;">${admins.length >= 2 ? 'Slots Full (2/2)' : '1 Slot Open'}</span>
            </div>
            <div style="margin-bottom: 12px;">
              <label style="font-size: 11px; font-weight: bold; color: #475569; display: block; margin-bottom: 4px;">Admin Username or Employee Code:</label>
              <input id="offline-login-id" type="text" placeholder="Enter admin username" style="width: 100%; padding: 10px 12px; border-radius: 10px; border: 1px solid #cbd5e1; font-size: 13px; font-family: monospace;">
            </div>
            <div style="margin-bottom: 16px;">
              <label style="font-size: 11px; font-weight: bold; color: #475569; display: block; margin-bottom: 4px;">Admin Security PIN / Password:</label>
              <input id="offline-login-pin" type="password" placeholder="Enter administrator PIN" style="width: 100%; padding: 10px 12px; border-radius: 10px; border: 1px solid #cbd5e1; font-size: 13px;">
            </div>
          `;
          if (submitBtn) {
            submitBtn.textContent = '🛡️ Log In as Administrator';
            submitBtn.style.background = '#0f172a';
          }
          if (toggleBox) {
            toggleBox.style.display = admins.length === 1 ? 'block' : 'none';
            toggleBox.innerHTML = `
              <button type="button" onclick="toggleOfflineAdminCreateMode()" style="background: #fef3c7; border: 1px solid #fde047; color: #78350f; font-size: 11px; font-weight: bold; padding: 6px 12px; border-radius: 8px; cursor: pointer;">
                + Register Secondary Admin Account (Slot 2/2)
              </button>
            `;
          }
        }
      } else {
        // Standard Student / Parent / Staff / Alumni Login Form
        if (toggleBox) toggleBox.style.display = 'none';
        if (submitBtn) {
          submitBtn.textContent = '🔐 Log In to Portal';
          submitBtn.style.background = '#065f46';
        }
        let labelText = 'UNEB Index or Admission Number:';
        let placeholderText = 'e.g. U0842/045';
        if (selectedOfflineRole === 'parent') {
          labelText = 'Registered Guardian Phone Number:';
          placeholderText = 'e.g. 0772 458 912';
        } else if (selectedOfflineRole === 'staff') {
          labelText = 'Staff Employment Code:';
          placeholderText = 'e.g. STAFF/0842/01';
        } else if (selectedOfflineRole === 'alumni') {
          labelText = 'Alumni ID or Class Year:';
          placeholderText = 'e.g. OB/2014/FN';
        }

        container.innerHTML = `
          <div style="margin-bottom: 12px;">
            <label id="offline-id-label" style="font-size: 11px; font-weight: bold; color: #475569; display: block; margin-bottom: 4px;">${labelText}</label>
            <input id="offline-login-id" type="text" placeholder="${placeholderText}" style="width: 100%; padding: 10px 12px; border-radius: 10px; border: 1px solid #cbd5e1; font-size: 13px; font-family: monospace;">
          </div>
          <div style="margin-bottom: 16px;">
            <label style="font-size: 11px; font-weight: bold; color: #475569; display: block; margin-bottom: 4px;">Security PIN / Password:</label>
            <input id="offline-login-pin" type="password" placeholder="Enter PIN / Password" style="width: 100%; padding: 10px 12px; border-radius: 10px; border: 1px solid #cbd5e1; font-size: 13px;">
          </div>
        `;
      }
    }

    function handleOfflineLogin() {
      const errEl = document.getElementById('login-error-msg');
      const succEl = document.getElementById('login-success-msg');
      if (errEl) errEl.style.display = 'none';
      if (succEl) succEl.style.display = 'none';

      // 1. ADMIN CREATION SUBMISSION
      if (selectedOfflineRole === 'admin' && (offlineAdminCreateMode || getOfflineAdmins().length === 0)) {
        const admins = getOfflineAdmins();
        if (admins.length >= 2) {
          if (errEl) {
            errEl.textContent = 'Maximum limit reached (2/2 admins). Only one or two admins are permitted.';
            errEl.style.display = 'block';
          }
          return;
        }

        const nameEl = document.getElementById('admin-create-fullname');
        const userEl = document.getElementById('admin-create-username');
        const titleEl = document.getElementById('admin-create-title');
        const pinEl = document.getElementById('admin-create-pin');
        const pinConfEl = document.getElementById('admin-create-pin-confirm');

        const nameVal = nameEl ? nameEl.value.trim() : '';
        const userVal = userEl ? userEl.value.trim().toLowerCase() : '';
        const titleVal = titleEl ? titleEl.value : 'School Administrator';
        const pinVal = pinEl ? pinEl.value.trim() : '';
        const pinConfVal = pinConfEl ? pinConfEl.value.trim() : '';

        if (!nameVal) {
          if (errEl) { errEl.textContent = 'Please enter administrator full name.'; errEl.style.display = 'block'; }
          return;
        }
        if (!userVal) {
          if (errEl) { errEl.textContent = 'Please enter administrator username or ID.'; errEl.style.display = 'block'; }
          return;
        }
        if (!pinVal || pinVal.length < 4) {
          if (errEl) { errEl.textContent = 'PIN / Password must be at least 4 characters.'; errEl.style.display = 'block'; }
          return;
        }
        if (pinVal !== pinConfVal) {
          if (errEl) { errEl.textContent = 'PIN confirmation does not match.'; errEl.style.display = 'block'; }
          return;
        }

        if (admins.some(a => a.username === userVal)) {
          if (errEl) { errEl.textContent = `Admin with username "${userVal}" already exists.`; errEl.style.display = 'block'; }
          return;
        }

        const newAdmin = {
          id: 'adm_' + Date.now(),
          fullName: nameVal,
          username: userVal,
          title: titleVal,
          pin: pinVal,
          isPrimary: admins.length === 0,
          createdAt: new Date().toLocaleDateString()
        };

        admins.push(newAdmin);
        saveOfflineAdmins(admins);

        if (succEl) {
          succEl.textContent = `Administrator account created successfully (${admins.length}/2)! Entering Admin Console...`;
          succEl.style.display = 'block';
        }

        currentOfflineUser = { name: newAdmin.fullName + ' (' + newAdmin.title + ')', role: 'admin' };
        setTimeout(() => {
          navigateTo('portal');
        }, 800);
        return;
      }

      // 2. ADMIN LOGIN SUBMISSION
      if (selectedOfflineRole === 'admin') {
        const idEl = document.getElementById('offline-login-id');
        const pinEl = document.getElementById('offline-login-pin');
        const idVal = idEl ? idEl.value.trim().toLowerCase() : '';
        const pinVal = pinEl ? pinEl.value.trim() : '';

        const admins = getOfflineAdmins();
        const matched = admins.find(a => a.username.toLowerCase() === idVal);

        if (!matched) {
          if (errEl) {
            errEl.textContent = 'Admin account not found. Please check username or create the admin account.';
            errEl.style.display = 'block';
          }
          return;
        }

        if (matched.pin && matched.pin !== pinVal) {
          if (errEl) {
            errEl.textContent = 'Incorrect administrator PIN or password.';
            errEl.style.display = 'block';
          }
          return;
        }

        currentOfflineUser = { name: matched.fullName + ' (' + matched.title + ')', role: 'admin' };
        navigateTo('portal');
        return;
      }

      // 3. STUDENT, PARENT, STAFF, ALUMNI LOGIN
      const idEl = document.getElementById('offline-login-id');
      const pinEl = document.getElementById('offline-login-pin');
      const idVal = idEl ? idEl.value.trim() : '';
      const pinVal = pinEl ? pinEl.value.trim() : '';

      if (!idVal) {
        if (errEl) {
          errEl.textContent = 'Please enter your UNEB Index, Admission Number, or Phone.';
          errEl.style.display = 'block';
        }
        return;
      }
      if (!pinVal || pinVal.length < 4) {
        if (errEl) {
          errEl.textContent = 'Please enter a valid PIN or password (at least 4 characters).';
          errEl.style.display = 'block';
        }
        return;
      }

      if (idVal.toUpperCase() === 'U0842/045' || idVal.toLowerCase().includes('farooq')) {
        STUDENT_DATA.name = "Farooq Kateregga";
        STUDENT_DATA.index = "U0842/045";
      } else {
        STUDENT_DATA.name = (selectedOfflineRole === 'parent' ? "Guardian (" + idVal + ")" : (selectedOfflineRole === 'staff' ? "Staff (" + idVal + ")" : "Student (" + idVal.toUpperCase() + ")"));
        STUDENT_DATA.index = idVal.toUpperCase();
      }

      currentOfflineUser = { name: STUDENT_DATA.name, role: selectedOfflineRole };
      navigateTo('portal');
    }

    function deleteOfflineAdmin(id) {
      if (confirm("Are you sure you want to remove this administrator? This will free up a slot.")) {
        const admins = getOfflineAdmins().filter(a => a.id !== id);
        saveOfflineAdmins(admins);
        renderPage('portal');
      }
    }

    // Download standalone file itself with exact filename index.html
    function downloadSelf() {
      const blob = new Blob([document.documentElement.outerHTML], { type: 'text/html;charset=utf-8' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'index.html';
      document.body.appendChild(a);
      a.click();
      a.remove();
    }

    // Toggle Offline Admissions Counselor Chat
    function toggleOfflineChat() {
      const chat = document.getElementById('offline-chat-modal');
      if (chat) {
        chat.style.display = chat.style.display === 'none' ? 'block' : 'none';
      }
    }

    function askOfflineChat(question) {
      const chatLog = document.getElementById('chat-log');
      if (!chatLog) return;
      
      const userBubble = document.createElement('div');
      userBubble.style.cssText = "background: #e2e8f0; color: #0f172a; padding: 8px 12px; border-radius: 12px; font-size: 12px; margin-bottom: 8px; align-self: flex-end; max-width: 85%; font-weight: 500;";
      userBubble.textContent = question;
      chatLog.appendChild(userBubble);

      // Determine answers based on authentic school knowledge base
      let reply = "Assalamu Alaikum. Thank you for inquiring about Shuhadae Islamic Secondary School, Nyamitanga Division, Mbarara City. Please reach our admissions office on 0705 705 967 or 0702 365 176 for personalized assistance.";
      const q = question.toLowerCase();
      if (q.includes('fee') || q.includes('cost') || q.includes('tuition')) {
        reply = "Our term fees: O-Level Boarding is UGX 950,000 / term (Day: UGX 520,000). A-Level Boarding is UGX 1,050,000 / term (Day: UGX 580,000). Fees cover tuition, lab consumables, computer/ICT, and halal meals. Flexible installments accepted through Centenary Bank & MTN SchoolPay.";
      } else if (q.includes('where') || q.includes('location') || q.includes('address') || q.includes('directions')) {
        reply = "We are located on Nyamitanga Hill, Nyamitanga Division, Mbarara City, Western Uganda (about 2 km off the Mbarara–Isingiro Highway). From Mbarara town center, cross the River Rwizi bridge, turn onto Isingiro Road, and branch right onto the school hill road (5 minutes drive).";
      } else if (q.includes('combination') || q.includes('a-level') || q.includes('subject')) {
        reply = "We offer Sciences: BCM (Biology, Chemistry, Math), PCB (Physics, Chemistry, Biology), PEM (Physics, Economics, Math), PCM. And Arts: HEG, DEG, HEL, MEA, and Arabic combinations alongside subsidiary ICT and Math.";
      } else if (q.includes('prayer') || q.includes('islam') || q.includes('deen') || q.includes('halal') || q.includes('tahfiz')) {
        reply = "Shuhadae observes all 5 daily prayers in our dedicated school mosque. We hold Friday Juma'at prayers, after-school Tahfiz (Quran memorization with certified Tajweed sheikhs), Hadith lessons, and provide 100% halal balanced nutrition.";
      } else if (q.includes('contact') || q.includes('phone') || q.includes('call') || q.includes('whatsapp')) {
        reply = "Reach the Headteacher and Admissions on 0705 705 967. Alumni lines: 0702 365 176 / 0755 260 894. Email: info@shuhadaeislamicssmbarara.com. WhatsApp: +256 705 705 967.";
      }

      setTimeout(() => {
        const botBubble = document.createElement('div');
        botBubble.style.cssText = "background: #ecfdf5; border: 1px solid #a7f3d0; color: #064e3b; padding: 10px 12px; border-radius: 12px; font-size: 12px; margin-bottom: 8px; align-self: flex-start; max-width: 90%; line-height: 1.4;";
        botBubble.innerHTML = "<strong>Ustadh Sulaiman (Admissions):</strong><br>" + reply;
        chatLog.appendChild(botBubble);
        chatLog.scrollTop = chatLog.scrollHeight;
      }, 300);
    }

    // Countdown Timer State & Controller for O-Level / A-Level Mocks
    let currentExamTarget = new Date('2026-11-02T08:30:00').getTime();
    let countdownTimerId = null;

    function setOfflineExam(type) {
      const btnUce = document.getElementById('btn-uce');
      const btnUace = document.getElementById('btn-uace');
      const title = document.getElementById('offline-exam-title');
      const sub = document.getElementById('offline-exam-subtitle');

      if (type === 'uce') {
        currentExamTarget = new Date('2026-11-02T08:30:00').getTime();
        if (title) title.textContent = "UCE Joint Mock Examinations (Senior Four O-Level)";
        if (sub) sub.textContent = "Main Examination Hall & Science Labs A/B • Commences Monday 02 Nov 2026";
        if (btnUce) { btnUce.style.background = '#f59e0b'; btnUce.style.color = '#022c22'; }
        if (btnUace) { btnUace.style.background = '#1e293b'; btnUace.style.color = '#e2e8f0'; }
      } else {
        currentExamTarget = new Date('2026-11-09T08:30:00').getTime();
        if (title) title.textContent = "UACE Joint Mock Examinations (Senior Six A-Level)";
        if (sub) sub.textContent = "Upper Campus Advanced Wing • Science & Arts Combinations • Starts Monday 09 Nov 2026";
        if (btnUce) { btnUce.style.background = '#1e293b'; btnUce.style.color = '#e2e8f0'; }
        if (btnUace) { btnUace.style.background = '#f59e0b'; btnUace.style.color = '#022c22'; }
      }
      tickCountdown();
    }

    function tickCountdown() {
      const daysEl = document.getElementById('cd-days');
      if (!daysEl) return;
      const now = new Date().getTime();
      const diff = currentExamTarget - now;
      if (diff <= 0) {
        document.getElementById('cd-days').textContent = '00';
        document.getElementById('cd-hours').textContent = '00';
        document.getElementById('cd-mins').textContent = '00';
        document.getElementById('cd-secs').textContent = '00';
        return;
      }
      const d = Math.floor(diff / (1000 * 60 * 60 * 24));
      const h = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const s = Math.floor((diff % (1000 * 60)) / 1000);
      
      document.getElementById('cd-days').textContent = String(d).padStart(2, '0');
      document.getElementById('cd-hours').textContent = String(h).padStart(2, '0');
      document.getElementById('cd-mins').textContent = String(m).padStart(2, '0');
      document.getElementById('cd-secs').textContent = String(s).padStart(2, '0');
    }

    function startOfflineCountdownTicker() {
      if (countdownTimerId) clearInterval(countdownTimerId);
      tickCountdown();
      countdownTimerId = setInterval(tickCountdown, 1000);
    }

    // Initial boot router: User requested login page as first page
    window.addEventListener('load', () => {
      const hash = window.location.hash.replace('#', '') || 'login';
      navigateTo(hash);
    });
  </script>
</body>
</html>
