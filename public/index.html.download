                  <label style="font-size: 11px; font-weight: bold; display: block; margin-bottom: 4px;">Applying For Class & Section:</label>
                  <select id="in-class" style="width: 100%; padding: 8px 12px; border-radius: 8px; border: 1px solid #cbd5e1; font-size: 12px;">
                    <option>Senior One (S.1) Boarding</option>
                    <option>Senior One (S.1) Day</option>
                    <option>Senior Five (S.5) Boarding</option>
                    <option>Senior Five (S.5) Day</option>
                  </select>
                </div>
                <div style="margin-bottom: 10px;">
                  <label style="font-size: 11px; font-weight: bold; display: block; margin-bottom: 4px;">PLE / UCE Score:</label>
                  <input id="in-score" type="text" placeholder="e.g. PLE Aggregate 8 (Div 1)" style="width: 100%; padding: 8px 12px; border-radius: 8px; border: 1px solid #cbd5e1; font-size: 12px;">
                </div>
                <div style="margin-bottom: 14px;">
                  <label style="font-size: 11px; font-weight: bold; display: block; margin-bottom: 4px;">Parent / Guardian Phone:</label>
                  <input id="in-phone" type="text" placeholder="e.g. 0772 123 456" style="width: 100%; padding: 8px 12px; border-radius: 8px; border: 1px solid #cbd5e1; font-size: 12px;">
                </div>
                <button onclick="saveOfflineForm()" style="width: 100%; padding: 10px; border-radius: 10px; background: #065f46; color: #ffffff; font-weight: 800; font-size: 13px;">
                  Submit & Print Application Slip
                </button>
              </div>
            </div>
          </div>
        `;
        return;
      }

      // PAGE: CAMPUS LIFE
      if (page === 'campus-life') {
        root.innerHTML = `
          <div class="max-w-7xl py-8">
            <h1 style="font-size: 32px; font-weight: 900; margin-bottom: 8px;">Campus Life in Nyamitanga</h1>
            <p style="font-size: 14px; color: #475569; margin-bottom: 24px;">Hostels, Halal Dining, Quran Competitions, and Inter-House Sports</p>
            <div class="grid sm:grid-cols-3 gap-6">
              <div style="background: #ffffff; padding: 20px; border-radius: 16px; border: 1px solid #e2e8f0;">
