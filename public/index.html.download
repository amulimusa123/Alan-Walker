              <div style="background: #fffbeb; border: 1px solid #fde68a; border-radius: 12px; padding: 12px; font-size: 12px; color: #92400e; margin-top: 12px; text-align: center;">
                🔒 <strong>Maximum admin limit reached (2/2 registered).</strong> Both permitted administrator slots are assigned.
              </div>
            `;
          }

          root.innerHTML = `
            <div class="max-w-7xl py-8">
