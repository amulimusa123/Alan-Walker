                <tr><td>Tuition & Instruction</td><td>UGX 380,000</td><td>UGX 450,000</td><td>UGX 420,000</td><td>UGX 520,000</td></tr>
                <tr><td>Boarding & Halal Meals</td><td>—</td><td>UGX 350,000</td><td>—</td><td>UGX 380,000</td></tr>
                <tr><td>Science Practical Consumables</td><td>UGX 50,000</td><td>UGX 50,000</td><td>UGX 70,000</td><td>UGX 70,000</td></tr>
                <tr><td>Computer / ICT & Internet</td><td>UGX 40,000</td><td>UGX 40,000</td><td>UGX 40,000</td><td>UGX 40,000</td></tr>
                <tr><td>Mosque & Tarbiyyah Welfare</td><td>UGX 20,000</td><td>UGX 20,000</td><td>UGX 20,000</td><td>UGX 20,000</td></tr>
                <tr><td>Medical Cover & Infirmary</td><td>UGX 30,000</td><td>UGX 40,000</td><td>UGX 30,000</td><td>UGX 40,000</td></tr>
                <tr style="background: #ecfdf5; font-weight: 900; font-size: 14px; color: #065f46;">
                  <td>TOTAL PER TERM</td><td>UGX 520,000</td><td>UGX 950,000</td><td>UGX 580,000</td><td>UGX 1,050,000</td>
                </tr>
              </table>
            </div>

            <!-- Online Application Form with LocalStorage -->
            <div style="background: #ffffff; padding: 28px; border-radius: 20px; border: 1px solid #cbd5e1; max-width: 600px; margin: 0 auto;">
              <h3 style="font-size: 18px; font-weight: 800; margin-bottom: 8px;">Instant Offline Admission Application</h3>
